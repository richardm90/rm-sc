/* RMSC: the project's own service programs, for *PGM objects and test        */
/* programs to bind to.                                                       */
/*                                                                            */
/* TOBi's CRTBNDRPGFLAGS has no BNDDIR parameter, and RUCRTRPG is not given    */
/* one either, so anything binding to RMSC must carry                         */
/* ctl-opt bnddir('RMSCPGM') in its source.                                   */
/*                                                                            */
/* The entry is library-qualified (&O, not *LIBL) deliberately: an entry       */
/* recorded as *LIBL makes activation search the caller's library list,       */
/* which would put a library-list requirement on every job calling RMSC.      */
!DLTOBJ OBJ(&O/&N) OBJTYPE(*BNDDIR)
CRTBNDDIR BNDDIR(&O/&N) +
          TEXT('RMSC: own service programs')
ADDBNDDIRE BNDDIR(&O/&N) +
   OBJ( (&O/RMSC *SRVPGM) )
