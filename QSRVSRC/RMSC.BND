STRPGMEXP PGMLVL(*CURRENT) SIGNATURE('RMSC 0.1.0')
  /* The signature is fixed, so the ORDER of these exports is the contract.
     Add new exports at the END only. Inserting one shifts every export after
     it by a position: the binder stays silent because the signature still
     matches, and previously-compiled callers then reach the wrong procedure.
     That shows up at runtime as RNX0115, not as a bind failure. */
  /* SCYAML - YAML reader */
  EXPORT SYMBOL(SCYAML_parse)
  EXPORT SYMBOL(SCYAML_error)
  EXPORT SYMBOL(SCYAML_has)
  EXPORT SYMBOL(SCYAML_value)
  EXPORT SYMBOL(SCYAML_is_seq)
  EXPORT SYMBOL(SCYAML_count)
  EXPORT SYMBOL(SCYAML_item)
  EXPORT SYMBOL(SCYAML_key_count)
  EXPORT SYMBOL(SCYAML_key_name)
  /* SCDEF - service definition model */
  EXPORT SYMBOL(SCDEF_load)
  EXPORT SYMBOL(SCDEF_from_doc)
  EXPORT SYMBOL(SCDEF_in_group)
  EXPORT SYMBOL(SCDEF_effective_dir)
  /* SCDIRS - definition directory resolution */
  EXPORT SYMBOL(SCDIRS_search_path)
  EXPORT SYMBOL(SCDIRS_home_dir)
  /* SCCOLL - definition collection */
  EXPORT SYMBOL(SCCOLL_init)
  EXPORT SYMBOL(SCCOLL_load)
  EXPORT SYMBOL(SCCOLL_load_dir)
  EXPORT SYMBOL(SCCOLL_count)
  EXPORT SYMBOL(SCCOLL_get)
  EXPORT SYMBOL(SCCOLL_find)
  EXPORT SYMBOL(SCCOLL_groups)
  EXPORT SYMBOL(SCCOLL_start_order)
  /* SCNET - network status via the TCP/IP list API */
  EXPORT SYMBOL(SCNET_port_listening)
  EXPORT SYMBOL(SCNET_last_error)
  /* SCQRY - system queries */
  EXPORT SYMBOL(SCQRY_port_listening)
  EXPORT SYMBOL(SCQRY_jobs_on_port)
  EXPORT SYMBOL(SCQRY_jobs_by_name)
  EXPORT SYMBOL(SCQRY_jobs_by_pgm)
  EXPORT SYMBOL(SCQRY_job_start_time)
  EXPORT SYMBOL(SCQRY_job_perf)
  EXPORT SYMBOL(SCQRY_jvm_info)
  EXPORT SYMBOL(SCQRY_splfs_for_job)
  /* SCOUT - output formatting */
  EXPORT SYMBOL(SCOUT_check_row)
  EXPORT SYMBOL(SCOUT_list_row)
  EXPORT SYMBOL(SCOUT_is_tty)
  EXPORT SYMBOL(SCOUT_set_colour)
  EXPORT SYMBOL(SCOUT_colour)
  EXPORT SYMBOL(SCOUT_writeln)
  /* SCLAUNCH - service launch */
  EXPORT SYMBOL(SCLAUNCH_build_env)
  EXPORT SYMBOL(SCLAUNCH_start_command)
  EXPORT SYMBOL(SCLAUNCH_job_name)
  EXPORT SYMBOL(SCLAUNCH_quote)
  EXPORT SYMBOL(SCLAUNCH_start)
  EXPORT SYMBOL(SCLAUNCH_run_stop_cmd)
  EXPORT SYMBOL(SCLAUNCH_endjob)
  /* SCLOG - service log location */
  EXPORT SYMBOL(SCLOG_dir)
  EXPORT SYMBOL(SCLOG_path)
  EXPORT SYMBOL(SCLOG_ensure_dir)
  /* SCEXEC - service operations */
  EXPORT SYMBOL(SCEXEC_criterion_alive)
  EXPORT SYMBOL(SCEXEC_status)
  EXPORT SYMBOL(SCEXEC_jobs)
  EXPORT SYMBOL(SCEXEC_check)
  EXPORT SYMBOL(SCEXEC_check_all)
  EXPORT SYMBOL(SCEXEC_list)
  EXPORT SYMBOL(SCEXEC_groups)
  EXPORT SYMBOL(SCEXEC_start)
  EXPORT SYMBOL(SCEXEC_stop)
  EXPORT SYMBOL(SCEXEC_restart)
  EXPORT SYMBOL(SCEXEC_info)
  EXPORT SYMBOL(SCEXEC_file)
  EXPORT SYMBOL(SCEXEC_jobinfo)
  EXPORT SYMBOL(SCEXEC_loginfo)
  EXPORT SYMBOL(SCEXEC_perfinfo)
  EXPORT SYMBOL(SCEXEC_scrunattrs)
  /* SCMAIN - command line */
  EXPORT SYMBOL(SCMAIN_parse)
  EXPORT SYMBOL(SCMAIN_adhoc)
  EXPORT SYMBOL(SCMAIN_run)
  /* SCAPI - public bound-call API */
  EXPORT SYMBOL(SC_check_all)
  EXPORT SYMBOL(SC_refresh)
  EXPORT SYMBOL(SC_check)
  EXPORT SYMBOL(SC_start)
  EXPORT SYMBOL(SC_stop)
  EXPORT SYMBOL(SC_kill)
  EXPORT SYMBOL(SC_restart)
  /* --- appended after 'RMSC 0.1.0' was first bound; keep appending below --- */
  /* SCJOB - active job lookup via QUSLJOB */
  EXPORT SYMBOL(SCJOB_by_name)
  EXPORT SYMBOL(SCJOB_last_error)
  /* SCOUT - warnings on standard error */
  EXPORT SYMBOL(SCOUT_warnln)
  EXPORT SYMBOL(SCOUT_no_services_warning)
ENDPGMEXP
