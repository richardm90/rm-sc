**free

//==============================================================================
// SCMAIN_D.rpgleinc
//   Command line copybook
//
// 29/08/2026 - RM - created
//==============================================================================

/if defined(SCMAIN_D)
/eof
/endif
/define SCMAIN_D

/include 'SCDEF_D.rpgleinc'
/include 'SCQRY_D.rpgleinc'
/include 'include/RMTOOLS_D.rpgleinc'

dcl-c SCMAIN_ARGS_SIZE const(1024);

dcl-s SCMAIN_ARGS_t varchar(SCMAIN_ARGS_SIZE) template;
dcl-s SCMAIN_OP_t   varchar(16) template;
dcl-s SCMAIN_SPEC_t varchar(256) template;

// Upstream's default. A bare 'check' lists what someone configured, not the
// several dozen host and TCP server definitions that ship with the system,
// and consumers depend on that.
dcl-c SCMAIN_DFT_IGNORE const('system');

///
// Exit statuses, upstream's, returned by SCMAIN_parse and SCMAIN_run.
//
// The status is returned by whichever procedure knows it, rather than being
// inferred by the caller from WHICH procedure failed. That inference used to
// hold by coincidence - a parse failure happened to mean 255 and a run failure
// 253 - and it cannot express a case upstream has: an unrecognised option,
// where upstream warns and carries on with a status of 0.
//
// opts.err carries anything still needing to be said, and is empty when there
// is nothing. So a status of 0 with a message means "it worked, say this",
// and a non-zero status with a message means "it failed, say this".
//
// A non-zero status with NO message is reserved for a failure that has
// already reported itself where it happened - a service the walk could not
// check, named on stderr in its own place in the listing. **No path produces
// that yet.** It is described here because the callers handle it, and because
// the alternative - reporting at the end - would put the message somewhere
// upstream does not.
///

dcl-c SCMAIN_EXIT_OK     const(0);
dcl-c SCMAIN_EXIT_FAILED const(253);
dcl-c SCMAIN_EXIT_USAGE  const(255);

///
// The parsed command line.
///

dcl-ds SCMAIN_OPTS_t qualified template inz;
  operation like(SCMAIN_OP_t)   inz('');
  spec      like(SCMAIN_SPEC_t) inz('');
  verbose   like(BOOLEAN_t) inz(false);
  quiet     like(BOOLEAN_t) inz(false);
  colours   like(BOOLEAN_t) inz(false);
  splf      like(BOOLEAN_t) inz(false);
  all       like(BOOLEAN_t) inz(false);
  ignore_globals like(BOOLEAN_t) inz(false);
  ignore_groups  like(SCDEF_NAME_t) inz(SCMAIN_DFT_IGNORE);
  // The raw text, kept for the message that quotes it back, and the value it
  // parsed to. Both, because upstream validates --sampletime WHEN IT PARSES
  // THE ARGUMENT rather than when perfinfo uses it - measured: it warns on
  // `check` and on `list` as well, and a `-q` placed AFTER the bad option
  // does not suppress the warning while one placed before it does. That
  // ordering is only reproducible if the value is converted in the parse
  // loop, in argument order, which is why the parsed figure lives here.
  sampletime     like(SCDEF_NAME_t) inz('1');
  sample_secs    like(SCQRY_SECS_t) inz(1);
  err       like(SCMAIN_ARGS_t) inz('');
end-ds;

///
// Parse a command line.
//
// Exposed so the parsing can be tested without running anything: an operation
// that quietly resolves to the wrong service, or a flag that silently does
// nothing, is the kind of fault that only shows up in production.
///

dcl-pr SCMAIN_parse like(INTEGER_t);
  args like(SCMAIN_ARGS_t) const;
  opts likeds(SCMAIN_OPTS_t);
end-pr;

///
// Build an ad hoc definition from a specifier that names a port, a job or a
// program rather than a configured service.
//
// Returns false if the specifier is not one of those forms.
///

dcl-pr SCMAIN_adhoc like(BOOLEAN_t);
  spec like(SCMAIN_SPEC_t) const;
  def  likeds(SCDEF_t);
end-pr;

///
// Run a parsed command line.
//
// Returns an exit status - see SCMAIN_EXIT_* above - and leaves opts.err
// holding anything the caller still needs to say. Clears opts.err on entry,
// so a message from the parse stage is not reported twice.
///

dcl-pr SCMAIN_run like(INTEGER_t);
  opts likeds(SCMAIN_OPTS_t);
end-pr;

///
// Filters $HOME/.scrc and SC_OPTIONS content down to the tokens RMSC's own
// parser recognises, in the order they should be applied ahead of the real
// command line - docs/parity.md, "scrc and SC_OPTIONS", DECIDED 19
// September 2026, has the full measured rule this follows.
//
// scrc_text is one argument per LINE - never split further, even on
// internal whitespace within a line. A blank line, or one whose first
// non-blank character is '#', is silently skipped. options_text is the
// opposite: one argument per WHITESPACE-separated word. This asymmetry
// between the two sources is measured and deliberate, not a bug to fix.
//
// A token is recognised, and kept, only if it is exactly one of the three
// shapes DECIDED for this - -a/--all, --ignore-groups=, or --sampletime= -
// and carries no embedded space or tab, since a recognised token is handed
// back as TEXT to be re-tokenised by SCMAIN_parse's own whitespace
// splitter, which has no idea any of it came from one .scrc line; keeping
// a spaced candidate "whole" here would only have it split apart again one
// call later, which can hand the verb itself to a word a config file
// wrote - see is_config_flag's own comment. Anything else - including a
// real upstream option RMSC does not implement yet (--color-scheme,
// deliberately out of scope for now), a flag RMSC's own parser DOES accept
// but this does not (-v, -q, --ignore-globals and the colour flags -
// scope, not an oversight), and a bare word - contributes nothing to the
// return value and is warned about once, with upstream's own wording,
// rather than silently dropped or allowed to change which command runs.
//
// @return the recognised tokens, space-joined, scrc_text's before
//   options_text's - ready to prepend, with a following space, to the
//   real command line before SCMAIN_parse sees any of it
///

dcl-pr SCMAIN_config_prefix like(SCMAIN_ARGS_t);
  scrc_text    like(STRING_t) const ccsid(*utf8);
  options_text like(SCMAIN_ARGS_t) const;
end-pr;
