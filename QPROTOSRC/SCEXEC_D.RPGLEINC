**free

//==============================================================================
// SCEXEC_D.rpgleinc
//   Service operations copybook
//
// 29/08/2026 - RM - created
//==============================================================================

/if defined(SCEXEC_D)
/eof
/endif
/define SCEXEC_D

/include 'SCCOLL_D.rpgleinc'
/include 'SCDEF_D.rpgleinc'
/include 'SCOUT_D.rpgleinc'
/include 'SCQRY_D.rpgleinc'
/include 'include/RMTOOLS_D.rpgleinc'

// Poll intervals. Upstream uses 2s for start and 2.5s for stop; DLYJOB takes
// whole seconds, so stop rounds to 3. Half a second on a poll interval makes
// no practical difference to when a service is seen to be up or down.
dcl-c SCEXEC_START_POLL const(2);
dcl-c SCEXEC_STOP_POLL  const(3);

dcl-s SCEXEC_ERR_t varchar(512) template;

///
// Whether a single check_alive criterion is currently satisfied.
///

dcl-pr SCEXEC_criterion_alive like(BOOLEAN_t);
  criterion likeds(SCDEF_CRITERION_t) const;
end-pr;

///
// A service's status: RUNNING when every criterion is satisfied, NOT RUNNING
// when none is, PARTIAL when some are.
//
// PARTIAL is easy to overlook and matters: a service declaring both a job and
// a port is half up if the job exists but nothing is listening yet.
///

dcl-pr SCEXEC_status like(SCOUT_STATUS_t);
  def likeds(SCDEF_t) const;
end-pr;

///
// The jobs currently satisfying a service's criteria.
///

dcl-pr SCEXEC_jobs like(INTEGER_t);
  def  likeds(SCDEF_t) const;
  jobs likeds(SCQRY_JOBS_t);
end-pr;

///
// Write one 'check' row for a service.
///

dcl-pr SCEXEC_check;
  def likeds(SCDEF_t) const;
end-pr;

///
// Write a 'check' row for every service in the collection, skipping the
// groups named in ignore_groups.
//
// The default exclusion is the 'system' group, and consumers rely on it: a
// bare 'check' lists the services someone actually configured, not the
// several dozen host and TCP server definitions that ship with the system.
///

// Returns how many services it displayed, so the caller can tell an empty
// result from a populated one and warn as upstream does.
dcl-pr SCEXEC_check_all like(INTEGER_t);
  coll          likeds(SCCOLL_t);
  ignore_groups like(SCDEF_NAME_t) const;
end-pr;

///
// Write a 'list' row for every service, same filtering as check.
///

// Returns how many services it listed, as SCEXEC_check_all does.
//
// Given only_group, lists just that group's members - the complement of
// ignore_groups, and what 'list group:NAME' needs. An explicitly named group
// wins over the exclusions, so ignore_groups is not applied as well.
dcl-pr SCEXEC_list like(INTEGER_t);
  coll          likeds(SCCOLL_t);
  ignore_groups like(SCDEF_NAME_t) const;
  only_group    like(SCDEF_NAME_t) const options(*nopass);
end-pr;

///
// Write every group name.
//
// 'system' is built in and is listed even when every one of its members has
// been filtered out - but NOT when the global directories were skipped, since
// upstream only adds the built-in entry when it read them.
///

dcl-pr SCEXEC_groups;
  coll           likeds(SCCOLL_t);
  ignore_groups  like(SCDEF_NAME_t) const;
  ignore_globals like(BOOLEAN_t) const options(*nopass);
end-pr;

///
// Start a service and everything it depends on, dependencies first.
//
// Returns once the service is alive, or false with err set if it does not
// come up within its startup_wait_time.
///

dcl-pr SCEXEC_start like(BOOLEAN_t);
  coll likeds(SCCOLL_t);
  name like(SCDEF_NAME_t) const;
  err  like(SCEXEC_ERR_t);
end-pr;

///
// Stop a service, and anything that depends on it first.
//
// kill skips the service's own stop_cmd and goes straight to ENDJOB, which is
// the difference between the 'stop' and 'kill' operations.
///

dcl-pr SCEXEC_stop like(BOOLEAN_t);
  coll likeds(SCCOLL_t);
  name like(SCDEF_NAME_t) const;
  kill like(BOOLEAN_t) const;
  err  like(SCEXEC_ERR_t);
end-pr;

///
// Stop then start.
///

dcl-pr SCEXEC_restart like(BOOLEAN_t);
  coll likeds(SCCOLL_t);
  name like(SCDEF_NAME_t) const;
  err  like(SCEXEC_ERR_t);
end-pr;

///
// Reporting operations. Each writes to standard output.
///

dcl-pr SCEXEC_info;
  def likeds(SCDEF_t) const;
end-pr;

dcl-pr SCEXEC_file;
  def likeds(SCDEF_t) const;
end-pr;

dcl-pr SCEXEC_jobinfo;
  def likeds(SCDEF_t) const;
end-pr;

dcl-pr SCEXEC_loginfo;
  def likeds(SCDEF_t) const;
end-pr;

dcl-pr SCEXEC_perfinfo;
  def likeds(SCDEF_t) const;
end-pr;

dcl-pr SCEXEC_scrunattrs;
  def likeds(SCDEF_t) const;
end-pr;

///
// Everything determining a service's status yields, rather than the label
// alone.
//
// SCEXEC_status answers the question the bound-call API asks - is it up - and
// must keep answering it in exactly those words, because SCAPI hands its
// result to consumers comparing against SC_PARTIAL. Displaying a row needs
// more: upstream reports 'PARTIAL (1/2)' and names the criteria that are not
// running. That is presentation built on the same evaluation, not a second
// evaluation - the criteria are live port and job lookups, and check runs them
// for every service.
///

dcl-ds SCEXEC_EVAL_t qualified template inz;
  state        like(SCOUT_STATUS_t) inz('');
  alive        like(INTEGER_t) inz(0);
  total        like(INTEGER_t) inz(0);
  failed_count like(INTEGER_t) inz(0);
  failed       like(SCDEF_NAME_t) dim(SCDEF_MAX_CRITERIA);
  failed_text  like(SCOUT_LINE_t) inz('');
end-ds;

///
// Evaluate a service once, probing each criterion exactly once.
//
// failed and failed_text are populated whenever criteria are not running,
// including when NONE is - upstream prints no suffix for a stopped service,
// so this is not visible in its output, but withholding the information from
// a caller that asked for an evaluation would be arbitrary.
//
// @param the definition to evaluate
// @param the result, cleared on entry. Named ev, not eval: EVAL is an
//   operation code, and a parameter called eval is parsed as one.
///

dcl-pr SCEXEC_evaluate;
  def likeds(SCDEF_t) const;
  ev  likeds(SCEXEC_EVAL_t);
end-pr;
