**free

//==============================================================================
// SCDEF_D.rpgleinc
//   Service definition model copybook
//
// 29/08/2026 - RM - created
//==============================================================================

/if defined(SCDEF_D)
/eof
/endif
/define SCDEF_D

///
// Include copybooks
///

/include 'SCYAML_D.rpgleinc'
/include 'include/RMTOOLS_D.rpgleinc'

///
// Constants definitions
///

dcl-c SCDEF_MAX_CRITERIA    const(8);
dcl-c SCDEF_MAX_ENVVARS     const(24);
dcl-c SCDEF_MAX_DEPS        const(16);
dcl-c SCDEF_MAX_GROUPS      const(16);
dcl-c SCDEF_MAX_UNKNOWN     const(16);

// Upstream defaults
dcl-c SCDEF_DFT_STARTUP_WAIT const(60);
dcl-c SCDEF_DFT_STOP_WAIT    const(45);

// check_alive criterion kinds
dcl-c SCDEF_CHECK_PORT      const('PORT');
dcl-c SCDEF_CHECK_JOB       const('JOB');
dcl-c SCDEF_CHECK_PGM       const('PGM');

///
// Template field definitions
///

// 512, and every one of these numbers is a SOURCE bound rather than a guess.
//
// This one type is the universal "a service or group name" across every
// module - short_name, service_dependencies, groups, the distinct-group list,
// the conflict claimants, bad_name, the start order, and the parameters that
// carry them. So it must be as wide as the widest thing that can reach any of
// them, which is a YAML sequence item at 512.
//
// AT 64 IT TRUNCATED, AND ONE CASE WAS WORSE THAN TRUNCATION. Measured
// against sc 1.7.1: a 100-character group came back cut to 64, a
// 100-character filename gave a 64-character service name, and TWO FILENAMES
// SHARING A 64-CHARACTER PREFIX BECAME ONE SERVICE - upstream lists two,
// RMSC listed one, and the other simply was not there. A row vanishing from
// `check` is the failure this project guards against hardest.
//
// A service name cannot exceed 251 (a filename is at most 255 including
// '.yaml', or '.yml' at four) and a group is a sequence item at 512, so 512
// covers both with nothing able to exceed it. Sized to the source, not to a
// number that felt roomy - which is what the previous five caps each were.
//
// FULLY EFFECTIVE AS OF rmtools 2.0.7, 7 September 2026. It was not when this
// was written: PATH_BASENAME_t was varchar(128), so PATH_name truncated a
// longer filename, lost the '.yaml' off the end, failed to find the dot, and
// returned an EMPTY name through a MONITOR - names of 65 to 127 characters
// worked and 128 to 251 did not.
//
// rmtools 2.0.7 widened that type to 255 and replaced the MONITOR with an
// explicit `pos > 0` guard. RMSC binds rmtools BY COPY, so a rebuild is all
// this side needed.
//
// **THIS PROJECT NOW REQUIRES rmtools >= 2.0.7.** Built against 2.0.6 the
// suites go red in about ten places across SCDEF, SCCOLL and SCLAUNCH with
// nothing naming the cause - the `..._blocked_on_rmtools` markers that used to
// say it out loud were flipped to real assertions when it landed, so the
// signal that named the dependency is gone. That is what this paragraph is
// for.
dcl-s SCDEF_NAME_t     varchar(512)  template;

// The same number as a constant, because a guard elsewhere has to REFUSE what
// will not fit this type and a literal 512 in that test would not say why.
//
// They must move together. The command line's --ignore-groups= list is checked
// against this before it is stored, and the matching side takes the list in a
// SCDEF_NAME_t - so if this type ever narrows and the guard does not follow,
// the divergence moves from "refused" back to "silently cut" one layer down,
// where nothing is looking.
dcl-c SCDEF_NAME_MAX const(512);
// 1024, matching the YAML scalar bound. `name:` is a plain scalar and scalars
// are guarded at 1024, so nothing can now exceed this. At 128 a 200-character
// `name:` was cut to 128 while upstream kept all 200 - on the description
// column of the byte-exact path.
dcl-s SCDEF_FRIENDLY_t varchar(1024) template;
dcl-s SCDEF_CMD_t      varchar(1024) template;
// One criterion as written. 128 rather than 64: at 64 a job name of 65
// characters was silently cut, and the cut was INVISIBLE because the rendering
// type was 64 too, so the text was truncated on the way in and again on the
// way out and the two caps hid each other. Fixing only the rendering moved the
// cap from 56 to 72 without removing it - the storage is the other half, and a
// test carrying a 20-character name could see neither.
//
// 128 IS THE SURVIVING EDGE, and it is named here so the next person measures
// against it rather than rediscovering the stack. Upstream renders longer; RMSC
// cuts at 128 characters of criterion. Far past anything real - a *JOB name is
// 10, SBS/JOB is 21, PGM- is 14 - so it is a limit rather than a defect.
//
// THAT CLAIM WAS WRONG WHEN IT WAS FIRST WRITTEN, and the correction is left
// here rather than tidied away, because the mistake is the useful part. Two
// MORE 64-wide holders were still standing underneath when this comment
// announced 128 as the surviving edge: SCCOLL's conflict comparison and
// SCEXEC_EVAL_t.failed. Both were found by review, neither by any test, and
// the first of them made conflict detection report nothing at all past 64
// characters rather than reporting something short.
//
// So the count reached FIVE caps, not three, and the lesson is about the
// method rather than the number: naming an edge does not establish it. What
// establishes it is a test at a value past every candidate cap - which is why
// the suites now carry cases at 28, 64, 65 and 136 rendered characters, the
// 65 being the one that separates "handled at every length" from its rival.
// Anyone widening SCDEF_CRIT_t again should sweep every holder that receives
// SCDEF_criterion_text before believing the job done.
dcl-s SCDEF_CRIT_t     varchar(128)  template;

///
// A rendered criterion: 'JOBNAME:' or 'PORT:' in front of a SCDEF_CRIT_t.
//
// Wider than SCDEF_CRIT_t plus its longest prefix, so the rendering can never
// be the thing that truncates. THREE caps were stacked here, each hiding the
// next: `info` cut at 10 (it built the text from a *JOB name field), this type
// cut at 56 (it was SCDEF_NAME_t, 64 wide, against a 72-character value), and
// the storage cut at 64. Removing them one at a time reported each fix as
// complete, because the next cap down was still doing the truncating.
///

dcl-s SCDEF_CRITTEXT_t varchar(160)  template;
dcl-s SCDEF_ENVVAR_t   varchar(512)  template;
dcl-s SCDEF_KIND_t     char(4)       template;
// Ten, because an IBM i object name is ten. Named as a constant as well as a
// width because SCDEF_from_doc has to REFUSE a longer sbmjob_jobname rather
// than truncate it, and a literal 10 in that test would not say why.
dcl-c SCDEF_JOBNAME_MAX const(10);

dcl-s SCDEF_OBJ_t      varchar(10)   template;

///
// One check_alive criterion.
//
// Upstream accepts four forms and tells them apart by shape:
//   8080          a port
//   JOBNAME       a job name
//   SBS/JOBNAME   a job name qualified by subsystem
//   PGM-NAME      jobs running that program from the main thread
///

dcl-ds SCDEF_CRITERION_t qualified template inz;
  kind      like(SCDEF_KIND_t) inz(*blanks);
  raw       like(SCDEF_CRIT_t) inz('');
  port      like(INTEGER_t)    inz(0);
  subsystem like(SCDEF_OBJ_t)  inz('');
  job_name  like(SCDEF_OBJ_t)  inz('');
  program   like(SCDEF_OBJ_t)  inz('');
end-ds;

///
// A service definition, with upstream's defaults applied.
///

dcl-ds SCDEF_t qualified template inz;
  err          like(SCYAML_ERROR_t) inz('');

  // Identity
  short_name   like(SCDEF_NAME_t)     inz('');
  friendly     like(SCDEF_FRIENDLY_t) inz('');
  defined_at   like(STMF_t)           inz('');

  // Commands and working directory
  dir          like(STMF_t)     inz('');
  start_cmd    like(SCDEF_CMD_t) inz('');
  stop_cmd     like(SCDEF_CMD_t) inz('');
  has_stop_cmd like(BOOLEAN_t)  inz(false);

  // Timings
  startup_wait like(INTEGER_t) inz(SCDEF_DFT_STARTUP_WAIT);
  stop_wait    like(INTEGER_t) inz(SCDEF_DFT_STOP_WAIT);

  // Batch submission
  batch_mode     like(BOOLEAN_t)   inz(false);
  sbmjob_jobname like(SCDEF_OBJ_t) inz('');
  sbmjob_opts    like(SCDEF_CMD_t) inz('');

  // Environment
  inherit_vars like(BOOLEAN_t) inz(true);
  log_dir      like(STMF_t)    inz('');

  only_if_executable like(STMF_t) inz('');

  // A cluster: key is parsed and rejected, never silently ignored
  is_cluster like(BOOLEAN_t) inz(false);

  criteria_count like(INTEGER_t) inz(0);
  criteria likeds(SCDEF_CRITERION_t) dim(SCDEF_MAX_CRITERIA);

  envvar_count like(INTEGER_t) inz(0);
  envvars like(SCDEF_ENVVAR_t) dim(SCDEF_MAX_ENVVARS);

  dep_count like(INTEGER_t) inz(0);
  deps like(SCDEF_NAME_t) dim(SCDEF_MAX_DEPS);

  group_count like(INTEGER_t) inz(0);
  groups like(SCDEF_NAME_t) dim(SCDEF_MAX_GROUPS);

  // Keys that are not part of the schema. Recorded, never fatal, so a new
  // upstream key cannot stop a definition loading.
  unknown_count like(INTEGER_t) inz(0);
  unknown like(SCYAML_KEY_t) dim(SCDEF_MAX_UNKNOWN);

  // 'enabled: false' hides the service completely - upstream does not list it,
  // check it or mention it. Default on, so a definition without the key, and
  // one whose key has no value, are both enabled.
  //
  // Appended rather than placed with the identity fields it belongs beside:
  // this structure is passed across the service-program boundary, where a size
  // change is silent to the binder. Appending is the conservative choice even
  // though nothing outside can currently see it - SCAPI exposes its own types,
  // and the only other declarers are the suites, which recompile every run.
  enabled like(BOOLEAN_t) inz(*on);
end-ds;

///
// Load a service definition from a YAML file.
//
// The short name comes from the file name, as upstream does it.
//
// @param path to the .yaml file
// @param the definition to populate
// @return true on success; false with def.err set
///

dcl-pr SCDEF_load like(BOOLEAN_t);
  stmf like(STMF_t) const;
  def  likeds(SCDEF_t);
end-pr;

///
// Build a definition from an already-parsed document.
//
// Separated from SCDEF_load so the mapping can be exercised without file I/O.
//
// @param the parsed document
// @param the path it came from, for short_name and defined_at
// @param the definition to populate
// @return true on success; false with def.err set
///

dcl-pr SCDEF_from_doc like(BOOLEAN_t);
  doc  likeds(SCYAML_DOC_t) const;
  stmf like(STMF_t) const;
  def  likeds(SCDEF_t);
end-pr;

///
// Does the definition belong to the named group?
///

dcl-pr SCDEF_in_group like(BOOLEAN_t);
  def   likeds(SCDEF_t) const;
  group like(SCDEF_NAME_t) const;
end-pr;

///
// The effective working directory: dir if given, else the directory holding
// the definition file. Relative dir values resolve against the latter.
///

dcl-pr SCDEF_effective_dir like(STMF_t);
  def likeds(SCDEF_t) const;
end-pr;

///
// One criterion, rendered the way upstream names it when reporting which
// criteria are not running:
//
//   a port           -> 'PORT:55999'
//   anything else    -> 'JOBNAME:' + the criterion text, upper-cased
//
// Upper-cased because upstream folds the criterion as it parses it, so the
// suffix never shows the case anyone wrote - confirmed against sc 1.7.1 with
// lower-case job, SBS/JOB and PGM- definitions. The SBS/JOB slash form and the
// PGM- prefix are part of the job name, not types of their own; there is no
// 'PGM:' rendering.
///

// NOTE FOR RMSC.BND: this return type widened from varchar(64). The signature
// pins the ORDER of the export list, not the SHAPES of what the exports return,
// so the binder says nothing about a change like this. Every caller in this
// repository rebuilds together, so nothing is at risk here - but an
// already-compiled caller outside it would read a different layout in silence,
// which is the failure CLAUDE.md describes for an inserted export arriving by
// another road.
dcl-pr SCDEF_criterion_text like(SCDEF_CRITTEXT_t);
  criterion likeds(SCDEF_CRITERION_t) const;
end-pr;

///
// Can this criterion be used to look for anything at all?
//
// False only for a port whose text is not a number - 'check_alive: port' with
// 'abc'. A job name of any length or shape is usable, measured: upstream
// accepts a 27-character one and simply reports the service NOT RUNNING.
//
// Usability is a property of the definition's text, not of the machine, so it
// can be settled without asking the system anything.
///

///
// Is this text a usable port, what number is it, and how should it be kept?
//
// One procedure because the three answers must come from ONE string. The
// ad-hoc path used to validate a criterion's stored `raw` - already cut to
// SCDEF_CRIT_t - and convert the caller's untruncated text, which abended on
// `port:` + 128 zeros + `4294967296`.
//
// `norm` is the text with leading zeros stripped. It matters because
// `port:<128 zeros>22` really is port 22 on both implementations, so "too
// long to store" is NOT the same as "unusable" and a fix that conflates them
// breaks a working command.
//
// @param the text, undamaged - STRING_t so nothing is lost before it is judged
// @param out: the port number, 0 when the answer is false
// @param out: the text as it should be stored
// @return true when the text is a port this system can use
///

dcl-pr SCDEF_port_text like(BOOLEAN_t);
  text like(STRING_t) const;
  port like(INTEGER_t);
  norm like(SCDEF_CRIT_t);
end-pr;

dcl-pr SCDEF_criterion_usable like(BOOLEAN_t);
  criterion likeds(SCDEF_CRITERION_t) const;
end-pr;

///
// Reset a definition to its declared defaults.
//
// Use this rather than CLEAR on an SCDEF_t. CLEAR ignores the template's inz,
// so a cleared definition arrives with enabled = *off and is treated as
// disabled - which once made every definition on the system vanish at once.
///

dcl-pr SCDEF_clear;
  def likeds(SCDEF_t);
end-pr;
