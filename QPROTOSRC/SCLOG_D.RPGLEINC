**free

//==============================================================================
// SCLOG_D.rpgleinc
//   Service log file location copybook
//
// 29/08/2026 - RM - created
//==============================================================================

/if defined(SCLOG_D)
/eof
/endif
/define SCLOG_D

/include 'SCDEF_D.rpgleinc'
/include 'include/RMTOOLS_D.rpgleinc'

// Relative to the user's home directory. Confirmed against upstream, which
// reports it as the place to look when a log cannot be found.
dcl-c SCLOG_DIR_REL const('.sc/logs');

///
// The log directory: the service's log_dir if it has one, else $HOME/.sc/logs.
///

dcl-pr SCLOG_dir like(STMF_t);
  def likeds(SCDEF_t) const;
end-pr;

///
// A fresh, timestamped path for a service being started now. Compute once
// per start and thread the result through - a second call for the same
// instance names a different file. See SCLOG.RPGLE for the exact format.
///

dcl-pr SCLOG_new_path like(STMF_t);
  def likeds(SCDEF_t) const;
end-pr;

///
// The MOST RECENT existing log file for a service, or '' if none. A service
// started more than once has one timestamped file per start; this finds the
// greatest matching name, which is the newest. Does not say whether the
// service that wrote it is still running - see SCEXEC_loginfo for that.
///

dcl-pr SCLOG_path like(STMF_t);
  def likeds(SCDEF_t) const;
end-pr;

///
// Create the log directory if it is missing.
//
// A service whose output cannot be written would otherwise fail to start for
// a reason that has nothing to do with the service.
///

dcl-pr SCLOG_ensure_dir like(BOOLEAN_t);
  def likeds(SCDEF_t) const;
end-pr;
