**free

//==============================================================================
// SCOUT_D.rpgleinc
//   Output formatting copybook
//
// 29/08/2026 - RM - created
//==============================================================================

/if defined(SCOUT_D)
/eof
/endif
/define SCOUT_D

/include 'include/RMTOOLS_D.rpgleinc'

///
// Service status values.
//
// These strings are an interface, not a display choice. Consumers parse
// 'check' output by column position and compare the status text literally.
///

dcl-c SCOUT_RUNNING     const('RUNNING');
dcl-c SCOUT_NOT_RUNNING const('NOT RUNNING');
dcl-c SCOUT_PARTIAL     const('PARTIAL');

///
// The 'check' row layout, which is fixed and must not drift.
//
//   '  ' + status padded to 18 + ' | ' + name + ' (' + description + ') '
//
//     1234567890123456789012345678901234567890
//       RUNNING            | webproxy (Web Proxy)
//     ^^                   ^
//     two spaces           '|' at column 22
//
// Status occupies columns 3-20, the bar column 22, the name starts at 24.
///

dcl-c SCOUT_STATUS_WIDTH const(18);
dcl-c SCOUT_BAR_COLUMN   const(22);
dcl-c SCOUT_NAME_COLUMN  const(24);

// 2048, not 1024, and the number has to survive an argument. A check row is
// '  ' + status(18) + ' | ' + name + ' (' + desc + ') ' + the not-running
// suffix, and that suffix is up to 8 criteria x 136 characters plus their
// separators - 1102 on its own, 1162 for the whole row.
//
// At 1024 both were cut, and measured rather than reasoned: failed_text held
// 1024 of 1102, the row held 1024 of 1162. What is lost is the TAIL - part of
// the last criterion and the closing bracket - on the byte-exact path a
// consumer parses by column, silently.
//
// The two overflow INDEPENDENTLY: widening one and not the other still cuts
// the row. They share this type, so one number fixes both, which is the only
// reason a single change is enough.
//
// This became reachable when SCDEF_CRIT_t went to 128. At 64 the worst case
// was about 590 and could not overflow - so this is the fourth cap in one
// chain, found the same way as the other three: by widening the one above it.
dcl-s SCOUT_LINE_t   varchar(2048) template;
dcl-s SCOUT_STATUS_t varchar(20)   template;

///
// One 'check' row.
//
// Byte-identical to upstream. If colour is on, ANSI escapes wrap the padded
// status, the short name and the not-running suffix - never a space, a bracket
// or the description - so the visible columns are unchanged and stripping the
// escapes yields the uncoloured row exactly. With colour off, which is the case
// whenever output is not a terminal, the row contains no escapes at all.
///

dcl-pr SCOUT_check_row like(SCOUT_LINE_t);
  status like(SCOUT_STATUS_t) const;
  name   like(SCOUT_LINE_t) const;
  desc   like(SCOUT_LINE_t) const;
  suffix like(SCOUT_LINE_t) const options(*nopass);
end-pr;

///
// One 'list' row: 'name (description)', with no leading or trailing padding.
///

// With colour on, the short name is wrapped in CYAN - fixed, not derived from
// the service's status, which this procedure is not given. Measured against
// sc 1.7.1 with running, partial and stopped services in one listing.
dcl-pr SCOUT_list_row like(SCOUT_LINE_t);
  name like(SCOUT_LINE_t) const;
  desc like(SCOUT_LINE_t) const;
end-pr;

///
// Is standard output a terminal?
//
// This decides whether colour is safe. It is not a cosmetic question: a
// consumer reading 'check' through a pipe takes the status from columns 3-20,
// and an ANSI escape sequence lands inside that field and corrupts it.
///

dcl-pr SCOUT_is_tty like(BOOLEAN_t);
end-pr;

///
// Turn colour on or off explicitly, for --disable-colors.
///

dcl-pr SCOUT_set_colour;
  enabled like(BOOLEAN_t) const;
end-pr;

///
// Is colour currently on? Defaults to SCOUT_is_tty() until set explicitly.
///

dcl-pr SCOUT_colour like(BOOLEAN_t);
end-pr;

///
// Write a line to standard output, terminated with a newline.
///

dcl-pr SCOUT_writeln;
  line like(SCOUT_LINE_t) const;
end-pr;

///
// Write a line to standard ERROR, terminated with a newline.
//
// Upstream routes its warnings to stderr, so anything parsing stdout by
// column position never sees them. A warning written to stdout would be read
// as a service row and dropped, or worse, misread.
///

dcl-pr SCOUT_warnln;
  line like(SCOUT_LINE_t) const;
end-pr;

///
// Upstream's warning for an operation that matched no services.
//
// Emitted for 'check' and 'list' - not 'groups' - whenever the set they would
// act on comes out empty, whether because a named group has no members,
// because the collection itself is empty, or because the group exclusions
// removed everything. A bare operation reports the implicit group, 'all'.
//
// The text is upstream's, verbatim, including the single quotes.
//
// @param the group name to report
// @return the warning line, without a trailing newline
///

dcl-pr SCOUT_no_services_warning like(SCOUT_LINE_t);
  group like(SCOUT_LINE_t) const;
end-pr;

///
// Upstream's status text for a partially-running service: 'PARTIAL (1/2)',
// the counts being alive over total.
///

dcl-pr SCOUT_partial_status like(SCOUT_STATUS_t);
  alive like(INTEGER_t) const;
  total like(INTEGER_t) const;
end-pr;

///
// Upstream's trailing note naming the criteria that are not running:
//
//   [not running at -->PORT:55998, JOBNAME:NOSUCHJOB3]
//
// Takes the criteria already joined with ', '. It is appended to a check row
// AFTER that row's trailing space, so the row itself is unchanged and the line
// simply ends with ']' instead.
///

dcl-pr SCOUT_not_running_suffix like(SCOUT_LINE_t);
  joined like(SCOUT_LINE_t) const;
end-pr;

///
// Upstream's complaint about a criterion it cannot use:
//
//   Invalid data for port number or job name criteria for service 'ZZ bad': PORT:abc
//
// The service is named by its FRIENDLY name, not its short name - which is
// the opposite of a check row, where "zzbad (ZZ bad)" leads with the short
// one. Written to standard error, in the service's own place in the walk, in
// place of the row it would otherwise have printed.
//
// @param the service's friendly name
// @param the criterion, rendered - see SCDEF_criterion_text
// @return the line, without a trailing newline
///

dcl-pr SCOUT_invalid_criteria like(SCOUT_LINE_t);
  friendly  like(SCOUT_LINE_t) const;
  criterion like(SCOUT_LINE_t) const;
end-pr;

///
// NARRATION - what upstream says while it is doing something.
//
// Every text below was captured from sc 1.7.1 on the box, and the captures and
// what they do and do not settle are in docs/messages.md. Read that before
// changing a byte of any of them.
//
// These are procedures returning a line rather than literals at the point of
// use, for the same reason SCOUT_check_row is: a returned string can be
// asserted from iRPGUnit, and a literal buried in SCEXEC can only be checked
// by a shell script comparing whole streams, where a one-byte difference is
// reported as "stdout differs" and has to be read out of a diff.
//
// THE STREAMS ARE NOT UNIFORM AND THAT IS NOT AN OVERSIGHT. The progress line,
// the four states, both dependency lines and the log-file detail go to STDOUT.
// The partial-state line, the shortfall warning and both errors go to STDERR.
// Upstream does this; RMSC copies it.
///

dcl-s SCOUT_STATE_t varchar(16) template;

dcl-c SCOUT_STARTED         const('STARTED');
dcl-c SCOUT_STOPPED         const('STOPPED');
dcl-c SCOUT_ALREADY_RUNNING const('ALREADY RUNNING');
dcl-c SCOUT_ALREADY_STOPPED const('ALREADY STOPPED');

///
// The progress line, printed once per service the command was asked about:
//
//   Performing operation 'START' on service 'rmscd2_parent'
//
// The verb is UPPER-CASED here rather than by the caller, so there is one
// place it can be got wrong. The service is named by its SHORT name - every
// other line in the family uses the friendly one, and that asymmetry is
// upstream's, measured, not a slip to tidy.
//
// @param the operation, in any case
// @param the service's short name
// @return the line, without a trailing newline
///

dcl-pr SCOUT_op_progress like(SCOUT_LINE_t);
  verb       like(SCOUT_LINE_t) const;
  short_name like(SCOUT_LINE_t) const;
end-pr;

///
// What became of a service, on STDOUT:
//
//   Service 'RMSC D2 narrate' successfully started
//   Service 'RMSC D2 narrate' is already running
//
// One of these is printed for EVERY service the operation touches, including
// a dependency started on the way - not only for the service that was named.
//
// @param the service's friendly name
// @param one of SCOUT_STARTED, SCOUT_STOPPED, SCOUT_ALREADY_RUNNING,
//        SCOUT_ALREADY_STOPPED
// @return the line, without a trailing newline
///

dcl-pr SCOUT_svc_state like(SCOUT_LINE_t);
  friendly like(SCOUT_LINE_t) const;
  state    like(SCOUT_STATE_t) const;
end-pr;

///
// A dependency about to be considered on the way to starting something:
//
//   Attempting to start service dependency 'rmscd2_depsvc' (RMSC D2 depsvc)...
//
// PRINTED EVEN WHEN THE DEPENDENCY IS ALREADY RUNNING and nothing is done.
// Measured. The wording says "attempting", so the natural implementation
// guards it behind having work to do; upstream prints it before it looks.
//
// @param the dependency's short name
// @param the dependency's friendly name
// @return the line, without a trailing newline
///

dcl-pr SCOUT_dep_start like(SCOUT_LINE_t);
  short_name like(SCOUT_LINE_t) const;
  friendly   like(SCOUT_LINE_t) const;
end-pr;

///
// A dependent about to be stopped so the service under it can go down:
//
//   Attempting to stop dependent service 'RMSC D2 labels'...
//
// NOT THE MIRROR OF SCOUT_dep_start, and this is measured rather than assumed.
// The start side names the service twice, short then friendly in parentheses;
// this side names it once, friendly only. It also says "dependent", not
// "dependency". Anyone making the two symmetrical is introducing a defect.
//
// @param the dependent's friendly name
// @return the line, without a trailing newline
///

dcl-pr SCOUT_dep_stop like(SCOUT_LINE_t);
  friendly like(SCOUT_LINE_t) const;
end-pr;

///
// A service that never came up, on STDERR:
//
//   ERROR: Timed out waiting for service 'RMSC gap partial' to start
//
// @param the service's friendly name
// @return the line, without a trailing newline
///

dcl-pr SCOUT_err_timeout like(SCOUT_LINE_t);
  friendly like(SCOUT_LINE_t) const;
end-pr;

///
// A dependency that would not start, on STDERR:
//
//   ERROR: Could not start dependency 'rmscd2_dep' for service 'RMSC D2 labels': ERROR: Timed out waiting for service 'RMSC D2 dependency' to start
//
// The nested message is embedded WHOLE, its own 'ERROR: ' prefix included, so
// the line carries the word twice. Measured.
//
// @param the dependency's short name
// @param the dependent service's friendly name
// @param the inner message, already rendered
// @return the line, without a trailing newline
///

dcl-pr SCOUT_err_dep_failed like(SCOUT_LINE_t);
  short_name like(SCOUT_LINE_t) const;
  friendly   like(SCOUT_LINE_t) const;
  nested     like(SCOUT_LINE_t) const;
end-pr;

///
// A service that is half up, on STDERR:
//
//   Service 'RMSC gap partial' is already partially running. You may need to restart if this operation fails.
//
// DELIBERATELY NOT A FIFTH SCOUT_svc_state CONSTANT. The four states go to
// stdout and this one goes to stderr, so folding it into the enumeration
// would put it on the wrong stream - a difference that has to be remembered
// rather than one the code makes structural.
//
// @param the service's friendly name
// @return the line, without a trailing newline
///

dcl-pr SCOUT_svc_partial like(SCOUT_LINE_t);
  friendly like(SCOUT_LINE_t) const;
end-pr;

///
// How far short a start fell, on STDERR:
//
//   WARNING: Service 'RMSC gap partial' only 1/2 started [failed to start --> [not running at -->JOBNAME:ZZNOSUCHJOB]]
//
// The inner bracket is byte-for-byte what SCOUT_not_running_suffix already
// produces for a check row, so this composes that rather than rendering the
// same criterion a second way. Two renderings of one thing in one codebase
// drift apart, and this one is on a line nobody looks at until it matters.
//
// @param the service's friendly name
// @param how many criteria were satisfied
// @param how many there are
// @param SCOUT_not_running_suffix's output for the ones that were not
// @return the line, without a trailing newline
///

dcl-pr SCOUT_only_started like(SCOUT_LINE_t);
  friendly like(SCOUT_LINE_t) const;
  alive    like(INTEGER_t) const;
  total    like(INTEGER_t) const;
  failures like(SCOUT_LINE_t) const;
end-pr;

///
// Where to look when a start failed, on STDOUT:
//
//   For details, see log file at: /home/x/.sc/logs/2026-09-03-17.57.56.svc.log
//
// This one is on the stream a consumer parses by column position, and it was
// in no catalogue anyone had read - it was found only by making a start fail.
//
// @param the log file path
// @return the line, without a trailing newline
///

dcl-pr SCOUT_log_detail like(SCOUT_LINE_t);
  path like(SCOUT_LINE_t) const;
end-pr;

///
// Whether anything is written at all.
//
// Off by default. It exists for SCAPI, whose header promises that a
// green-screen caller will not find stray text under its display file -
// narration is emitted from SCEXEC, which both entry points share, so that
// promise became false the moment RMSC learned to narrate.
//
// SAVE AND RESTORE AROUND A CALL:
//
//   was = SCOUT_silent();
//   SCOUT_set_silent(*on);
//   ...
//   SCOUT_set_silent(was);
//
// The flag is module state and lives for the ACTIVATION, not the call.
// Clearing it unconditionally on the way out un-silences at the first inner
// return, and SC_restart calls SC_stop and SC_start - so the naive version
// stops being silent half way through itself.
///

dcl-pr SCOUT_set_silent;
  enabled like(BOOLEAN_t) const;
end-pr;

dcl-pr SCOUT_silent like(BOOLEAN_t);
end-pr;
