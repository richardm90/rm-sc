**free

//==============================================================================
// SCOUT_D.rpgleinc
//   Output formatting copybook
//
// 29/08/2026 - RM - created
//==============================================================================

/if defined(SCOUT_D)
/eof
/endif
/define SCOUT_D

/include 'include/RMTOOLS_D.rpgleinc'

///
// Service status values.
//
// These strings are an interface, not a display choice. Consumers parse
// 'check' output by column position and compare the status text literally.
///

dcl-c SCOUT_RUNNING     const('RUNNING');
dcl-c SCOUT_NOT_RUNNING const('NOT RUNNING');
dcl-c SCOUT_PARTIAL     const('PARTIAL');

///
// The 'check' row layout, which is fixed and must not drift.
//
//   '  ' + status padded to 18 + ' | ' + name + ' (' + description + ') '
//
//     1234567890123456789012345678901234567890
//       RUNNING            | webproxy (Web Proxy)
//     ^^                   ^
//     two spaces           '|' at column 22
//
// Status occupies columns 3-20, the bar column 22, the name starts at 24.
///

dcl-c SCOUT_STATUS_WIDTH const(18);
dcl-c SCOUT_BAR_COLUMN   const(22);
dcl-c SCOUT_NAME_COLUMN  const(24);

dcl-s SCOUT_LINE_t   varchar(1024) template;
dcl-s SCOUT_STATUS_t varchar(20)   template;

///
// One 'check' row.
//
// Byte-identical to upstream. If colour is on, ANSI escapes wrap the padded
// status so the visible columns are unchanged; with colour off - which is the
// case whenever output is not a terminal - the row contains no escapes at all.
///

dcl-pr SCOUT_check_row like(SCOUT_LINE_t);
  status like(SCOUT_STATUS_t) const;
  name   like(SCOUT_LINE_t) const;
  desc   like(SCOUT_LINE_t) const;
  suffix like(SCOUT_LINE_t) const options(*nopass);
end-pr;

///
// One 'list' row: 'name (description)', with no leading or trailing padding.
///

dcl-pr SCOUT_list_row like(SCOUT_LINE_t);
  name like(SCOUT_LINE_t) const;
  desc like(SCOUT_LINE_t) const;
end-pr;

///
// Is standard output a terminal?
//
// This decides whether colour is safe. It is not a cosmetic question: a
// consumer reading 'check' through a pipe takes the status from columns 3-20,
// and an ANSI escape sequence lands inside that field and corrupts it.
///

dcl-pr SCOUT_is_tty like(BOOLEAN_t);
end-pr;

///
// Turn colour on or off explicitly, for --disable-colors.
///

dcl-pr SCOUT_set_colour;
  enabled like(BOOLEAN_t) const;
end-pr;

///
// Is colour currently on? Defaults to SCOUT_is_tty() until set explicitly.
///

dcl-pr SCOUT_colour like(BOOLEAN_t);
end-pr;

///
// Write a line to standard output, terminated with a newline.
///

dcl-pr SCOUT_writeln;
  line like(SCOUT_LINE_t) const;
end-pr;

///
// Write a line to standard ERROR, terminated with a newline.
//
// Upstream routes its warnings to stderr, so anything parsing stdout by
// column position never sees them. A warning written to stdout would be read
// as a service row and dropped, or worse, misread.
///

dcl-pr SCOUT_warnln;
  line like(SCOUT_LINE_t) const;
end-pr;

///
// Upstream's warning for an operation that matched no services.
//
// Emitted for 'check' and 'list' - not 'groups' - whenever the set they would
// act on comes out empty, whether because a named group has no members,
// because the collection itself is empty, or because the group exclusions
// removed everything. A bare operation reports the implicit group, 'all'.
//
// The text is upstream's, verbatim, including the single quotes.
//
// @param the group name to report
// @return the warning line, without a trailing newline
///

dcl-pr SCOUT_no_services_warning like(SCOUT_LINE_t);
  group like(SCOUT_LINE_t) const;
end-pr;

///
// Upstream's status text for a partially-running service: 'PARTIAL (1/2)',
// the counts being alive over total.
///

dcl-pr SCOUT_partial_status like(SCOUT_STATUS_t);
  alive like(INTEGER_t) const;
  total like(INTEGER_t) const;
end-pr;

///
// Upstream's trailing note naming the criteria that are not running:
//
//   [not running at -->PORT:55998, JOBNAME:NOSUCHJOB3]
//
// Takes the criteria already joined with ', '. It is appended to a check row
// AFTER that row's trailing space, so the row itself is unchanged and the line
// simply ends with ']' instead.
///

dcl-pr SCOUT_not_running_suffix like(SCOUT_LINE_t);
  joined like(SCOUT_LINE_t) const;
end-pr;
